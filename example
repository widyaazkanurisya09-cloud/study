          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Nama Lengkap</label>
            <input type="text" placeholder="Masukkan nama Anda" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Email</label>
            <input type="email" placeholder="nama@email.com" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Pesan</label>
