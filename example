            <div class="flex items-center gap-3 text-slate-300 text-sm">
              <div class="p-2 rounded-lg bg-slate-800 text-indigo-400"><i data-lucide="mail" class="w-5 h-5"></i></div>
              <span>alex.dev@example.com</span>
            </div>
            <div class="flex items-center gap-3 text-slate-300 text-sm">
              <div class="p-2 rounded-lg bg-slate-800 text-indigo-400"><i data-lucide="map-pin" class="w-5 h-5"></i></div>
