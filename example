    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Project Card 1 -->
      <div class="bg-slate-800/40 rounded-2xl overflow-hidden border border-slate-700/60 group hover:border-slate-600 transition-all flex flex-col">
        <div class="overflow-hidden">
          <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=800" alt="Dashboard SaaS" class="w-full h-52 object-cover group-hover:scale-105 transition duration-500" />
