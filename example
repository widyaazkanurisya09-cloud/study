            </div>
            <a href="#" class="inline-flex items-center gap-1 text-sm text-indigo-400 hover:text-indigo-300 font-medium">
              Demo <i data-lucide="external-link" class="w-4 h-4"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Project Card 2 -->
